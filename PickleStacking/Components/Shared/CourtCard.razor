<div class="court-card @(Court.IsActive ? "court-active" : "court-idle")">
    <div class="court-header">
        <span class="court-name">@Court.DisplayName</span>
        @if (Court.IsActive)
        {
            <span class="court-live">LIVE</span>
        }
        else
        {
            <span class="court-open">OPEN</span>
        }
    </div>

    @if (Court.IsActive)
    {
        <div class="court-match">
            <div class="team team-a">
                <span class="team-label">A</span>
                <div class="team-players">
                    @for (var i = 0; i < Court.TeamA!.Players.Count; i++)
                    {
                        var player = Court.TeamA.Players[i];
                        <span class="player-slot @(selectedPlayerId == player.Id ? "selected" : "")"
                              draggable="true"
                              @ondragstart="() => OnDragStart(player.Id)"
                              @ondragover="OnDragOver"
                              @ondragover:preventDefault="true"
                              @ondrop="() => OnDrop(player.Id)"
                              @onclick="() => OnSlotTap(player.Id)"
                              title="Drag on desktop or tap to select, then tap another player to swap">
                            @player.Name
                        </span>
                    }
                </div>
            </div>
            <div class="vs">VS</div>
            <div class="team team-b">
                <span class="team-label">B</span>
                <div class="team-players">
                    @for (var i = 0; i < Court.TeamB!.Players.Count; i++)
                    {
                        var player = Court.TeamB.Players[i];
                        <span class="player-slot @(selectedPlayerId == player.Id ? "selected" : "")"
                              draggable="true"
                              @ondragstart="() => OnDragStart(player.Id)"
                              @ondragover="OnDragOver"
                              @ondragover:preventDefault="true"
                              @ondrop="() => OnDrop(player.Id)"
                              @onclick="() => OnSlotTap(player.Id)"
                              title="Drag on desktop or tap to select, then tap another player to swap">
                            @player.Name
                        </span>
                    }
                </div>
            </div>
        </div>

        @if (selectedPlayerId != null)
        {
            <div class="repair-hint">Tap another player to swap</div>
        }

        <div class="court-actions">
            <button class="btn btn-win" @onclick="() => HandleResult(true)">TEAM A WON</button>
            <button class="btn btn-loss" @onclick="() => HandleResult(false)">TEAM B WON</button>
        </div>
    }
    else
    {
        <div class="court-empty">Waiting for next game</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Court Court { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<bool> OnResult { get; set; }

    [Parameter]
    public EventCallback<(string PlayerIdA, string PlayerIdB)> OnRepair { get; set; }

    private string? draggedPlayerId;
    private string? selectedPlayerId;

    private void OnDragStart(string playerId)
    {
        draggedPlayerId = playerId;
    }

    private void OnDragOver(DragEventArgs e)
    {
        // Default prevented via @ondragover:preventDefault="true"
    }

    private async Task OnDrop(string targetPlayerId)
    {
        if (string.IsNullOrEmpty(draggedPlayerId) || draggedPlayerId == targetPlayerId)
        {
            draggedPlayerId = null;
            return;
        }

        var playerIdA = draggedPlayerId;
        draggedPlayerId = null;
        if (selectedPlayerId == playerIdA || selectedPlayerId == targetPlayerId)
        {
            selectedPlayerId = null;
        }
        await OnRepair.InvokeAsync((playerIdA, targetPlayerId));
    }

    private async Task OnSlotTap(string playerId)
    {
        // Touch/mouse tap repair: first tap selects, second tap on another player swaps.
        if (selectedPlayerId == null)
        {
            selectedPlayerId = playerId;
            return;
        }

        if (selectedPlayerId == playerId)
        {
            // Tap the same player again to deselect
            selectedPlayerId = null;
            return;
        }

        var fromId = selectedPlayerId;
        selectedPlayerId = null;
        await OnRepair.InvokeAsync((fromId, playerId));
    }

    private async Task HandleResult(bool teamAWon)
    {
        selectedPlayerId = null;
        await OnResult.InvokeAsync(teamAWon);
    }
}