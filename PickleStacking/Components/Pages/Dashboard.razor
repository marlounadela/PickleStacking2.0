@page "/"
@inject StackingService Stacking
@inject SessionService SessionService
@inject CourtService CourtService

<PageTitle>Dashboard - PickleStacking</PageTitle>

<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1>Pickleball Stacking</h1>
            <p class="subtitle">Automatic matchmaking & court queue</p>
        </div>
        <div class="session-stats">
            <div class="stat">
                <span class="stat-label">Players</span>
                <span class="stat-value">@Stacking.Players.Count</span>
            </div>
            <div class="stat">
                <span class="stat-label">Courts</span>
                <span class="stat-value">@Stacking.Session.CourtsCount</span>
            </div>
            <div class="stat">
                <span class="stat-label">Mode</span>
                <span class="stat-value">@Stacking.Session.Mode</span>
            </div>
            <div class="stat">
                <span class="stat-label">Session</span>
                <span class="stat-value session-@SessionStatusCss">@SessionStatusLabel</span>
            </div>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-error">@errorMessage</div>
    }

    <div class="session-controls">
        @if (!Stacking.Session.IsActive)
        {
            <button class="btn btn-primary" @onclick="StartSession">START SESSION</button>
        }
        else
        {
            <button class="btn btn-secondary" @onclick="TogglePause">
                @(Stacking.Session.IsPaused ? "RESUME SESSION" : "PAUSE SESSION")
            </button>
            <button class="btn btn-danger" @onclick="ConfirmReset">RESET SESSION</button>
        }
    </div>

    @if (Stacking.Session.IsActive)
    {
        <section class="section">
            <h2 class="section-title">Active Courts</h2>
            @if (Stacking.Courts.Any(c => c.IsActive))
            {
                <div class="courts-grid">
                    @foreach (var court in Stacking.Courts.Where(c => c.IsActive))
                    {
                        <CourtCard Court="@court"
                                   OnResult="(won) => RecordResult(court.Number, won)"
                                   OnRepair="(swap) => RepairCourt(court.Number, swap.PlayerIdA, swap.PlayerIdB)" />
                    }
                </div>
            }
            else
            {
                <div class="empty-state">No active games. Waiting for players…</div>
            }
        </section>

        <div class="dashboard-columns">
            <section class="section">
                <h2 class="section-title">Next Up</h2>
                @{
                    var nextUp = Stacking.GetNextUp();
                    var courtsCount = Stacking.Session.CourtsCount;
                    var displayCount = Math.Min(nextUp.Count, courtsCount);
                }
                @if (displayCount > 0)
                {
                    <div class="next-up-list">
                        @for (var i = 0; i < displayCount; i++)
                        {
                            <div class="next-up-item">
                                <span class="next-up-court">Court @(i + 1)</span>
                                <span class="next-up-match">
                                    @nextUp[i].TeamAName
                                    <span class="vs-small">vs</span>
                                    @nextUp[i].TeamBName
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">No upcoming games.</div>
                }
            </section>

            <section class="section">
                <h2 class="section-title">Waiting Queue</h2>
                @{
                    var waiting = Stacking.WaitingQueue.ToList();
                }
                @if (waiting.Count > 0)
                {
                    <ol class="queue-list">
                        @for (var i = 0; i < waiting.Count; i++)
                        {
                            <li class="queue-item">
                                <span class="queue-number">@(i + 1)</span>
                                <span class="queue-name">@waiting[i].Name</span>
                                <StatusBadge Player="@waiting[i]" />
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <div class="empty-state">Queue is empty.</div>
                }
            </section>
        </div>

        <section class="section">
            <h2 class="section-title">Player Status</h2>
            <div class="table-wrap">
                <table class="status-table">
                    <thead>
                        <tr>
                            <th>Player</th>
                            <th>Status</th>
                            <th>Games</th>
                            <th>W</th>
                            <th>L</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in Stacking.Players)
                        {
                            <tr>
                                <td>@player.Name</td>
                                <td><StatusBadge Player="@player" /></td>
                                <td>@player.GamesPlayed</td>
                                <td>@player.Wins</td>
                                <td>@player.Losses</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <div class="empty-state big">
            <p>No active session.</p>
            <p class="muted">Add players, then press <strong>START SESSION</strong> to begin.</p>
        </div>
    }
</div>

@code {
    private string? errorMessage;

    private string SessionStatusLabel => !Stacking.Session.IsActive
        ? "INACTIVE"
        : Stacking.Session.IsPaused ? "PAUSED" : "ACTIVE";

    private string SessionStatusCss => !Stacking.Session.IsActive
        ? "inactive"
        : Stacking.Session.IsPaused ? "paused" : "active";

    private void StartSession()
    {
        errorMessage = null;
        try
        {
            SessionService.Start();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void TogglePause()
    {
        errorMessage = null;
        SessionService.Pause();
    }

    private async Task ConfirmReset()
    {
        errorMessage = null;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Reset the session? All games and results will be cleared.");
        if (confirmed)
        {
            SessionService.Reset();
        }
    }

    private void RecordResult(int courtNumber, bool teamAWon)
    {
        errorMessage = null;
        CourtService.RecordResult(courtNumber, teamAWon);
    }

    private void RepairCourt(int courtNumber, string playerIdA, string playerIdB)
    {
        errorMessage = null;
        CourtService.Repair(courtNumber, playerIdA, playerIdB);
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;
}